{
	"functions": [
		{
			"source": "functions",
			"codebase": "default",
			"runtime": "nodejs22",
			"ignore": ["node_modules", ".git", "*.local"]
		}
	],
	"hosting": {
		"public": "build",
		"cleanUrls": true,
		"trailingSlash": false,
		"ignore": ["firebase.json", "**/.*"],
		"rewrites": [
			{ "source": "/api/interest", "function": { "functionId": "interest", "region": "us-central1" } },
			{ "source": "**", "destination": "/200.html" }
		],
		"headers": [
			{
				"source": "/_app/immutable/**",
				"headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
			},
			{
				"source": "/videos/**",
				"headers": [{ "key": "Cache-Control", "value": "public, max-age=86400" }]
			}
		]
	}
}
