# ── Content (Sanity) ───────────────────────────────────────────
# Pulled at build time by `npm run content` (runs before dev/build) and baked
# into the static site. Leave unset to use the bundled seed content.
SANITY_PROJECT_ID=xdzal2ol
SANITY_DATASET=production
# Only for a private dataset (Viewer token from sanity.io/manage):
SANITY_READ_TOKEN=
# Fail the build when Sanity can't be reached (recommended in CI):
SANITY_STRICT=

# ── Enquiry emails (Resend) — local dev only ────────────
# `npm run dev` serves /api/interest itself. Without a key, the email is
# printed in the terminal instead of sent. In production these live in the
# Firebase Function (see functions/.env.example).
RESEND_API_KEY=
RESEND_FROM="SymphoZen Academia <hello@your-verified-domain.com>"
INTEREST_TO=team@your-domain.com
