{
	"compilerOptions": {
		"target": "ES2022",
		"lib": ["DOM", "DOM.Iterable", "ES2022"],
		"module": "Preserve",
		"moduleResolution": "bundler",
		"jsx": "preserve",
		"strict": true,
		"skipLibCheck": true,
		"noEmit": true,
		"allowJs": true,
		"isolatedModules": true,
		"esModuleInterop": true,
		"resolveJsonModule": true,
		"types": ["node"]
	},
	"include": ["**/*.ts", "**/*.tsx", ".sanity/**/*"],
	"exclude": ["node_modules", "dist"]
}
