		"@tailwindcss/vite": "^4.3.3",
		"@types/node": "^24.19.1",
		"@types/three": "^0.186.0",
		"svelte": "^5.57.1",
		"svelte-check": "^4.7.6",
		"tailwindcss": "^4.3.3",
		"typescript": "^6.0.3",
		"vite": "^8.3.2"
	},
	"dependencies": {
		"@lucide/svelte": "^1.52.0",
		"gsap": "^3.15.0",
		"three": "^0.186.1"
