{
	"name": "sympholearn",
	"private": true,
	"version": "0.1.0",
	"type": "module",
	"scripts": {
		"content": "node --env-file-if-exists=.env scripts/sanity-sync.mjs",
		"predev": "npm run content",
		"dev": "vite dev",
		"prebuild": "npm run content",
		"build": "vite build",
